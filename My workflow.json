      "parameters": {
        "jsCode": "const items = $input.all();\n\nfor (let i = 0; i < items.length; i++) {\n  // Puxa o áudio real do HD do servidor\n  const buffer = await this.helpers.getBinaryDataBuffer(i, 'data');\n  \n  // Transforma em texto Base64 de verdade e salva\n  items[i].json.audio_base64 = buffer.toString('base64');\n}\n\nreturn items;"
